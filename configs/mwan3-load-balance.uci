config policy 'operation_balance'
	list use_member 'wan1_m1_w50'
	list use_member 'wan2_m1_w50'
	list use_member 'wan3_m3_w1'

config rule 'default_rule'
	option dest_ip '0.0.0.0/0'
	option use_policy 'operation_balance'
	option sticky '0'

config rule 'gaming_udp'
	option proto 'udp'
	option dest_port '3074,3478:3480,3659,500,4500,27000:27100'
	option use_policy 'low_latency_wan1'
	option sticky '1'
	option timeout '3600'

config rule 'voip'
	option proto 'udp'
	option dest_port '5060:5061,10000:20000'
	option use_policy 'low_latency_wan1'
	option sticky '1'
	option timeout '3600'
