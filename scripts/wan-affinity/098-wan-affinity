#!/bin/sh
# /usr/share/omr/post-tracking.d/098-wan-affinity
#
# Per-device WAN affinity with automatic failover. Replaces 098-vivo-pin and
# the 099-ecmp-balance load-balancer.
#
# Model:
#   - Vivo (wan1) is the default WAN for every LAN device.
#   - Devices whose MAC is in the Claro lock list are marked 0x20000 by
#     /etc/nftables.d/20-wan-affinity.nft and routed via Claro (wan2).
#   - Devices in the Vivo lock list are marked 0x10000 (explicit; same as default).
#
# Routing:
#   mark 0x10000 -> ip rule prio 40 -> table 100 (Vivo primary, Claro failover)
#   mark 0x20000 -> ip rule prio 41 -> table 101 (Claro primary, Vivo failover)
#   unmarked LAN -> ip rule prio 45 iif br-lan -> table 100 (Vivo default),
#                   placed before OMR core's pri-50 ECMP rule (table 991337).
#
# Why this design:
#   - Each table holds a SINGLE nexthop. No ECMP, no L4 hash, so a device's
#     flows never split across two public IPs mid-session. This is what keeps
#     streaming/gaming stable (the old ECMP path egressed one device from both
#     Vivo and Claro at once and broke TLS resume / QUIC migration / anti-fraud).
#   - Failover is just rewriting the single nexthop of each table from live WAN
#     state. Marks never change, so when the WAN returns the device shifts back.
#   - Runs every omr-tracker tick. Idempotent.
#
# Gateways are sourced from each WAN's own table (6 = wan1, 10 = wan2), which OMR
# always populates even though defaultroute=0 leaves the ubus route arrays empty.

set -eu

# Egress-verified liveness. The old check trusted openmptcprouter.<wan>.state,
# which goes stale: a Vivo PPPoE flap could leave wan1.state="down" while the
# link was actually fine, and this script would then dump the whole LAN onto the
# double-NAT Claro. Probe the WAN's actual egress instead -- ping bound to the
# WAN device (SO_BINDTODEVICE) sends out that exact link regardless of routing
# tables, so success/failure reflects real reachability, not cached state.
# Two targets so a single dead resolver doesn't false-negative a live WAN.
#
# ICMP-blocking ISPs (Claro blocks ICMP to the public internet -- the same
# reason configure-omr-tracker.sh sets wan2 tracker type=none): ICMP alone
# would permanently mark WAN2 dead here and misroute table 101. So when ICMP
# fails, fall back to a device-bound plain-HTTP probe via curl --interface.
# A completed HTTP response (any status; curl exit 0) proves L3/L4 egress;
# cert/clock issues can't false-negative. Bounded: 2s connect, 3s total.
# Default target is a NUMERIC IP so the probe never depends on DNS (a
# hostname would resolve via the normal route and leak/false-signal).
# Overridable via uci wan_affinity.probe.http_url for captive/proxy cases.
#
# curl --interface support is verified at INSTALL time by
# configure-wan-affinity.sh (install aborts without it). If curl vanishes
# at runtime anyway (e.g. package removed), that is an INVALID probe config:
# log daemon.err edge-triggered and return failure -- but never pretend the
# ICMP result alone is authoritative for an ICMP-blocked ISP.
PROBE_URL=$(uci -q get wan_affinity.probe.http_url 2>/dev/null || true)
[ -n "$PROBE_URL" ] || PROBE_URL="http://1.1.1.1/cdn-cgi/trace"

_curl_ok=0
command -v curl >/dev/null 2>&1 && curl --help all 2>/dev/null | grep -q -- --interface && _curl_ok=1

_http_reach() {
	if [ "$_curl_ok" != 1 ]; then
		if [ ! -f /tmp/wan-affinity.nocurl ]; then
			logger -t wan-affinity -p daemon.err \
				"probe config INVALID: curl --interface unavailable; HTTP fallback for ICMP-blocked WANs is disabled (reinstall curl / re-run configure-wan-affinity.sh)" 2>/dev/null || true
			: > /tmp/wan-affinity.nocurl
		fi
		return 1
	fi
	rm -f /tmp/wan-affinity.nocurl
	curl -sS --interface "$1" -o /dev/null --connect-timeout 2 --max-time 3 "$PROBE_URL" >/dev/null 2>&1
}

_reach() {
	ping -W1 -c1 -I "$1" 1.1.1.1 >/dev/null 2>&1 && return 0
	ping -W1 -c1 -I "$1" 8.8.8.8 >/dev/null 2>&1 && return 0
	_http_reach "$1"
}

GW1=$(ip route show table 6  2>/dev/null | awk '/^default/{print $3;exit}')
DEV1=$(ip route show table 6  2>/dev/null | awk '/^default/{print $5;exit}')
GW2=$(ip route show table 10 2>/dev/null | awk '/^default/{print $3;exit}')
DEV2=$(ip route show table 10 2>/dev/null | awk '/^default/{print $5;exit}')

# A WAN is usable only if its table has a nexthop AND its egress actually reaches
# the internet. Probe result is authoritative -- it overrides stale uci state in
# both directions (stale-down working WAN stays in service; stale-up dead WAN is
# excluded so traffic is never dumped onto a black hole).
WAN1_OK=0
WAN2_OK=0
[ -n "${GW1:-}" ] && [ -n "${DEV1:-}" ] && _reach "$DEV1" && WAN1_OK=1
[ -n "${GW2:-}" ] && [ -n "${DEV2:-}" ] && _reach "$DEV2" && WAN2_OK=1

# table 100 = Vivo primary, Claro failover
if [ "$WAN1_OK" = 1 ]; then
	ip route replace default scope global table 100 via "$GW1" dev "$DEV1"
elif [ "$WAN2_OK" = 1 ]; then
	ip route replace default scope global table 100 via "$GW2" dev "$DEV2"
fi

# table 101 = Claro primary, Vivo failover
if [ "$WAN2_OK" = 1 ]; then
	ip route replace default scope global table 101 via "$GW2" dev "$DEV2"
elif [ "$WAN1_OK" = 1 ]; then
	ip route replace default scope global table 101 via "$GW1" dev "$DEV1"
fi

# ---- both-WAN-down handling --------------------------------------------------
# When neither WAN passes the egress probe the blocks above skip both tables,
# which previously left the last-known nexthop in 100/101 (traffic silently
# routed at a dead gateway). Two distinct cases:
#
#   1. Probes failed but a nexthop still exists (tables 6/10 populated): keep
#      the last-known route (fail-static). Both probes can false-negative in
#      the same tick under congestion/ICMP loss, and flushing here would
#      hard-down the LAN on a blip AND let lookups fall through the empty
#      table into OMR core's pri-50 ECMP rule (table 991337) -- the
#      flow-splitting behavior this script exists to prevent. Log it so the
#      state is visible.
#
#   2. No nexthop exists at all (tables 6/10 empty -- links torn down, e.g.
#      dead PPPoE with the session gone): any default left in 100/101 points
#      at a dismantled path. Replace it with `unreachable` so clients get an
#      immediate ICMP error instead of a silent blackhole, and so the lookup
#      still terminates in the table (no ECMP fall-through). The `ip route
#      replace default ... via` calls above overwrite the unreachable route
#      on the first tick a WAN recovers.
if [ "$WAN1_OK" = 0 ] && [ "$WAN2_OK" = 0 ]; then
	# Edge-triggered logging: this hook runs every tracker tick, so a per-tick
	# warning would flood the logread ring buffer during a sustained outage.
	# /tmp flag (tmpfs) records "already logged"; cleared on recovery below.
	if [ ! -f /tmp/wan-affinity.bothdown ]; then
		logger -t wan-affinity -p daemon.warn \
			"both WAN egress probes failed (wan1=${DEV1:-none} wan2=${DEV2:-none}); LAN has no verified uplink" 2>/dev/null || true
		: > /tmp/wan-affinity.bothdown
	fi
	if [ -z "${GW1:-}" ] && [ -z "${GW2:-}" ]; then
		ip route replace unreachable default table 100
		ip route replace unreachable default table 101
	fi
elif [ -f /tmp/wan-affinity.bothdown ]; then
	logger -t wan-affinity -p daemon.notice \
		"WAN egress restored (wan1_ok=$WAN1_OK wan2_ok=$WAN2_OK)" 2>/dev/null || true
	rm -f /tmp/wan-affinity.bothdown
fi

# Policy rules (idempotent).
ip rule show | grep -q "fwmark 0x10000/0x10000 lookup 100" \
	|| ip rule add priority 40 fwmark 0x10000/0x10000 lookup 100
ip rule show | grep -q "fwmark 0x20000/0x20000 lookup 101" \
	|| ip rule add priority 41 fwmark 0x20000/0x20000 lookup 101
# LAN default at priority 45: strictly BEFORE OMR core's pri-50
# "iif br-lan lookup 991337" ECMP rule (rebuilt every tick by
# common-post-tracking.sh / 003-up, which runs before this script). Because 45 <
# 50, unmarked LAN traffic resolves table 100 (Vivo) first and OMR's 991337 rule
# is permanently shadowed -- no per-tick deletion race, survives OMR upgrades.
ip rule show | grep -qE "^45:[[:space:]].*iif br-lan lookup 100" \
	|| ip rule add priority 45 iif br-lan lookup 100

# Drop the pri-50 br-lan->100 rule an earlier version of this script added
# (superseded by the pri-45 rule above). Bounded loop, no early break.
_i=0
while ip rule show | grep -qE "^50:[[:space:]].*iif br-lan lookup 100" && [ "$_i" -lt 16 ]; do
	ip rule del priority 50 iif br-lan lookup 100 2>/dev/null
	_i=$((_i + 1))
done

# ---- balanced-policy spillover steering --------------------------------------
# Opt-in per device via /etc/wan-affinity/balanced.list; explicit pins and the
# unlisted->WAN1 default are NEVER affected. New balanced flows are steered to
# the target WAN; existing flows stay put via ct-mark stickiness (see
# gen-dyn-nft.sh -- masked to 0x30000, dual-register foreign-mark guards).
#
# HARD GATE: byte counters cannot indicate congestion without knowing the real
# usable rate of each link, and guessed defaults could steer traffic INTO a
# saturated slower WAN. So steering stays OFF until the operator has saved
# explicit down/up Mbps for BOTH WANs (uci wan_affinity.capacity.*, set via the
# web UI). Health failover above is independent and always active.
#
# Overload signal: per-tick byte deltas from /sys/class/net -> EWMA (alpha
# 3/10, integer math) -> percent of configured capacity. Flip only when the
# current target is above HI_PCT AND the other WAN is below LO_PCT AND
# COOLDOWN_S has elapsed since the last flip (prevents ping-pong when a burst
# straddles both links). A dead target WAN flips immediately (health first).
GEN_DYN=/usr/lib/wan-affinity/gen-dyn-nft.sh
BAL_LIST="${WA_DIR:-/etc/wan-affinity}/balanced.list"
STATE=/tmp/wan-affinity.steer

cap_d1=$(uci -q get wan_affinity.capacity.wan1_down_mbps 2>/dev/null || true)
cap_u1=$(uci -q get wan_affinity.capacity.wan1_up_mbps   2>/dev/null || true)
cap_d2=$(uci -q get wan_affinity.capacity.wan2_down_mbps 2>/dev/null || true)
cap_u2=$(uci -q get wan_affinity.capacity.wan2_up_mbps   2>/dev/null || true)
HI_PCT=$(uci -q get wan_affinity.capacity.hi_pct 2>/dev/null || true)
LO_PCT=$(uci -q get wan_affinity.capacity.lo_pct 2>/dev/null || true)
COOLDOWN_S=$(uci -q get wan_affinity.capacity.cooldown_s 2>/dev/null || true)

_num() { case "$1" in ''|*[!0-9]*) return 1 ;; *) [ "$1" -gt 0 ] ;; esac; }
_uint() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

# Threshold sanity: strictly 0 < LO < HI <= 100, cooldown a nonnegative int.
# Anything malformed or out of bounds falls back to defaults (edge-logged) so a
# bad uci value can't abort the hook under `set -e` mid-arithmetic, and so
# hysteresis is never inverted (LO >= HI would flap every tick).
if ! _num "${HI_PCT:-}" || ! _num "${LO_PCT:-}" || [ "${HI_PCT:-0}" -gt 100 ] \
	|| [ "${LO_PCT:-0}" -ge "${HI_PCT:-0}" ]; then
	if [ -n "${HI_PCT:-}${LO_PCT:-}" ] && [ ! -f /tmp/wan-affinity.badthresh ]; then
		logger -t wan-affinity -p daemon.warn \
			"invalid hi_pct/lo_pct ('${HI_PCT:-}'/'${LO_PCT:-}'); using defaults 85/60 (need 0 < lo < hi <= 100)" 2>/dev/null || true
		: > /tmp/wan-affinity.badthresh
	fi
	HI_PCT=85; LO_PCT=60
else
	rm -f /tmp/wan-affinity.badthresh
fi
_uint "${COOLDOWN_S:-}" || COOLDOWN_S=120

_bal_active=0
if [ -x "$GEN_DYN" ] && [ -s "$BAL_LIST" ] \
	&& grep -qE '^[[:space:]]*[0-9a-fA-F:]' "$BAL_LIST" 2>/dev/null \
	&& _num "${cap_d1:-}" && _num "${cap_u1:-}" && _num "${cap_d2:-}" && _num "${cap_u2:-}"; then
	_bal_active=1
fi

if [ "$_bal_active" = 1 ]; then
	now=$(date +%s)
	rx1=$(cat "/sys/class/net/${DEV1:-none}/statistics/rx_bytes" 2>/dev/null || echo 0)
	tx1=$(cat "/sys/class/net/${DEV1:-none}/statistics/tx_bytes" 2>/dev/null || echo 0)
	rx2=$(cat "/sys/class/net/${DEV2:-none}/statistics/rx_bytes" 2>/dev/null || echo 0)
	tx2=$(cat "/sys/class/net/${DEV2:-none}/statistics/tx_bytes" 2>/dev/null || echo 0)

	# state: ts rx1 tx1 rx2 tx2 e_d1 e_u1 e_d2 e_u2 target flip_ts
	p_ts=0; p_rx1=0; p_tx1=0; p_rx2=0; p_tx2=0
	e_d1=0; e_u1=0; e_d2=0; e_u2=0; target=wan1; flip_ts=0
	[ -f "$STATE" ] && read -r p_ts p_rx1 p_tx1 p_rx2 p_tx2 e_d1 e_u1 e_d2 e_u2 target flip_ts < "$STATE" 2>/dev/null || true
	case "$target" in wan1|wan2) ;; *) target=wan1 ;; esac

	dt=$((now - p_ts))
	if [ "$dt" -ge 1 ] && [ "$dt" -le 600 ] && [ "$p_ts" -gt 0 ]; then
		# Bytes/s this window; counter reset/wrap (negative delta) -> treat as 0.
		_rate() { d=$(( $1 - $2 )); [ "$d" -lt 0 ] && d=0; echo $(( d / dt )); }
		r_d1=$(_rate "$rx1" "$p_rx1"); r_u1=$(_rate "$tx1" "$p_tx1")
		r_d2=$(_rate "$rx2" "$p_rx2"); r_u2=$(_rate "$tx2" "$p_tx2")
		# EWMA alpha=3/10: e = (3*sample + 7*e) / 10
		e_d1=$(( (3*r_d1 + 7*e_d1) / 10 )); e_u1=$(( (3*r_u1 + 7*e_u1) / 10 ))
		e_d2=$(( (3*r_d2 + 7*e_d2) / 10 )); e_u2=$(( (3*r_u2 + 7*e_u2) / 10 ))

		# Utilization %: worst of down/up vs configured capacity (Mbps*125000 B/s).
		u1d=$(( e_d1 * 100 / (cap_d1 * 125000) )); u1u=$(( e_u1 * 100 / (cap_u1 * 125000) ))
		u2d=$(( e_d2 * 100 / (cap_d2 * 125000) )); u2u=$(( e_u2 * 100 / (cap_u2 * 125000) ))
		util1=$u1d; [ "$u1u" -gt "$util1" ] && util1=$u1u
		util2=$u2d; [ "$u2u" -gt "$util2" ] && util2=$u2u

		new_target=$target
		if [ "$target" = wan1 ] && [ "$WAN1_OK" = 0 ] && [ "$WAN2_OK" = 1 ]; then
			new_target=wan2   # health beats cooldown
		elif [ "$target" = wan2 ] && [ "$WAN2_OK" = 0 ] && [ "$WAN1_OK" = 1 ]; then
			new_target=wan1
		elif [ $((now - flip_ts)) -ge "$COOLDOWN_S" ]; then
			if [ "$target" = wan1 ] && [ "$WAN2_OK" = 1 ] \
				&& [ "$util1" -ge "$HI_PCT" ] && [ "$util2" -le "$LO_PCT" ]; then
				new_target=wan2
			elif [ "$target" = wan2 ] && [ "$WAN1_OK" = 1 ] \
				&& [ "$util2" -ge "$HI_PCT" ] && [ "$util1" -le "$LO_PCT" ]; then
				new_target=wan1
			fi
		fi

		if [ "$new_target" != "$target" ]; then
			logger -t wan-affinity -p daemon.notice \
				"balanced steering: $target -> $new_target (util1=${util1}% util2=${util2}% hi=$HI_PCT lo=$LO_PCT)" 2>/dev/null || true
			target=$new_target
			flip_ts=$now
			"$GEN_DYN" "$target" || logger -t wan-affinity -p daemon.err "gen-dyn-nft.sh $target failed" 2>/dev/null || true
		fi
	fi

	# (Re)install the dyn table if missing (first activation, fw4 full restart).
	nft list table inet wan_affinity_dyn >/dev/null 2>&1 \
		|| "$GEN_DYN" "$target" 2>/dev/null \
		|| logger -t wan-affinity -p daemon.err "gen-dyn-nft.sh install failed" 2>/dev/null || true

	printf '%s %s %s %s %s %s %s %s %s %s %s\n' \
		"$now" "$rx1" "$tx1" "$rx2" "$tx2" "$e_d1" "$e_u1" "$e_d2" "$e_u2" "$target" "$flip_ts" > "$STATE"
else
	# Steering disabled (unconfigured capacities or empty balanced.list): tear
	# down the dyn chain so no stale steering rule outlives its configuration,
	# and drop stale samples so re-enable starts with a fresh EWMA.
	nft delete table inet wan_affinity_dyn >/dev/null 2>&1 || true
	rm -f "$STATE"
fi
