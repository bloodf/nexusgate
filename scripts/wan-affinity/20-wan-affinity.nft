# /etc/nftables.d/20-wan-affinity.nft  (REFERENCE / EXAMPLE)
#
# The live file on the router is generated by scripts/configure-wan-affinity.sh
# from the VIVO_MACS / CLARO_MACS lists so empty sets are omitted (nft rejects
# an empty `{ }` set). This file documents the resulting structure.
#
# Marks (companion: /usr/share/omr/post-tracking.d/098-wan-affinity):
#   0x10000 -> ip rule prio 40 -> table 100 (Vivo primary, Claro failover)
#   0x20000 -> ip rule prio 41 -> table 101 (Claro primary, Vivo failover)
# Unmarked LAN traffic falls through to ip rule prio 45 -> table 100 (Vivo
# default), placed before OMR core's pri-50 ECMP rule so it always wins.
#
# Hook prerouting priority -150 runs before the routing decision, so the mark is
# in place when the kernel evaluates the fwmark ip rules.

chain wan_affinity {
    type filter hook prerouting priority -150; policy accept;

    # Claro-locked devices (e.g. streaming boxes) -> Claro (wan2).
    ether saddr {
        40:f6:bc:38:df:7c, 44:d5:cc:e5:ad:a7,
        1c:fe:2b:f3:84:fc, a8:a0:92:2f:9a:dc
    } meta mark set meta mark | 0x20000 counter comment "pin Claro"

    # Vivo-locked devices -> Vivo (wan1). Explicit; Vivo is also the default.
    ether saddr {
        06:72:3d:90:06:10, 22:f6:ca:e4:09:46, 34:29:8f:70:87:c8,
        48:e1:ca:06:f4:12, 4e:42:43:17:1d:6f, a4:6b:40:32:23:20,
        bc:35:1e:a3:f1:5d, be:53:2a:62:8b:dd, e0:85:4d:46:3d:6e,
        f4:d4:88:66:07:9c, fa:b3:8b:3c:da:f1
    } meta mark set meta mark | 0x10000 counter comment "pin Vivo"
}
